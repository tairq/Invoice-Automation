# App
APP_NAME=InvoiceProcessor
DEBUG=true
SECRET_KEY=change-me-to-a-random-string

# Database
DATABASE_URL=postgresql+asyncpg://invoice_user:invoice_pass@localhost:5432/invoice_processor

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1

# LLM (AI Extraction)
# Option 1: Anthropic (Claude)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5-20250601

# Option 2: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_MODEL=gpt-4o

# Option 3: Custom OpenAI-compatible endpoint (OpenRouter, Together AI, Groq, local LLM, etc.)
# LLM_PROVIDER=custom
# CUSTOM_API_KEY=your-api-key
# CUSTOM_API_BASE=https://api.openrouter.ai/v1
# CUSTOM_MODEL=openai/gpt-4o

# OCR fallback (only needed if LLM vision is unavailable)
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGES=eng

# Processing
CONFIDENCE_THRESHOLD=0.85
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,tiff,eml

# Email Monitoring
# EMAIL_HOST=imap.gmail.com
# EMAIL_PORT=993
# EMAIL_USERNAME=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password
# EMAIL_CHECK_INTERVAL=300

# Logging
LOG_LEVEL=INFO

# Airtable Sync (replaces Streamlit dashboard)
# AIRTABLE_API_KEY=pat-your-airtable-api-key
# AIRTABLE_BASE_ID=appYourBaseId
# AIRTABLE_INVOICES_TABLE=Invoices
# AIRTABLE_LINE_ITEMS_TABLE=Line Items
# AIRTABLE_SYNC_ENABLED=false

# API Key Authentication
ADMIN_API_KEY=change-me-admin-key

# Xero Integration (optional)
# Desktop app (PKCE flow) — no client_secret needed
# Web app — also set XERO_CLIENT_SECRET
# XERO_CLIENT_ID=your-xero-client-id
# XERO_CLIENT_SECRET=your-xero-client-secret
# XERO_ENABLED=false
# XERO_REDIRECT_URI=http://localhost:18080/xero-callback

# Approval Workflow
# APPROVAL_THRESHOLD=0  # 0 = require approval for all invoices; set > 0 to auto-approve below amount
# APPROVAL_BASE_URL=http://localhost:8000
# APPROVAL_FROM_EMAIL=noreply@invoiceprocessor.com
# APPROVAL_RECIPIENT_EMAIL=admin@example.com

# SMTP (for approval emails + payment reminders)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_TLS=true

# Payment Reminders
# PAYMENT_REMINDER_EMAIL=accounts@example.com

# Admin (webhook dead-letter alerts)
# ADMIN_EMAIL=admin@example.com

# n8n Integration (optional)
# N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/invoice-processed
# N8N_ENABLED=false
